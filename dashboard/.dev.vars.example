# Copy to .dev.vars (gitignored) for `npm run dev`. Never commit real keys.
# Local Supabase (`npx supabase start` from brink-merge/):
#   SUPABASE_URL is the API URL it prints (http://127.0.0.1:54321).
#   SUPABASE_SERVICE_ROLE_KEY is the service_role key it prints
#   (`npx supabase status -o env` -> SERVICE_ROLE_KEY). It stays in the Worker;
#   the browser never receives it.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Optional, LOCAL ONLY: edit the schematic without Cloudflare Access. Edits are recorded under
# this email with editor_auth = 'dev-bypass'. Honoured only while ACCESS_TEAM_DOMAIN is unset and
# the request arrives on a loopback host (src/access.ts); never put it in wrangler.toml.
# DEV_ONLY_ACCESS_BYPASS_EMAIL=you@example.com
