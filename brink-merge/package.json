{
  "name": "brink-merge",
  "version": "0.1.0",
  "private": true,
  "description": "Internal Brink Design tool: OpenTakeoff Division 27 export -> priced-ready BOM + EasySchematic project file, with a Postgres/Supabase system of record and a headless MCP server.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "brink-merge": "./bin/brink-merge.mjs",
    "brink-merge-mcp": "./bin/brink-merge-mcp.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "cli": "tsx src/cli.ts",
    "mcp": "tsx src/mcp/main.ts",
    "vendor:es": "node scripts/vendor-es.mjs",
    "fixtures:es-open": "node scripts/es-open-check.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
