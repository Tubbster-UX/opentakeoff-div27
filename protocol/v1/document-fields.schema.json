{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentakeoff.kentucky-ai.com/protocol/v1/document-fields.schema.json",
  "title": "Existing document collections (draft)",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string"
    },
    "units": {
      "enum": [
        "imperial",
        "metric"
      ]
    },
    "client_info": {
      "type": "object"
    },
    "sheets": {
      "type": "array",
      "items": {
        "$ref": "calibration.schema.json"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "condition.schema.json"
      }
    },
    "shapes": {
      "type": "array",
      "items": {
        "$ref": "measurement.schema.json"
      }
    },
    "markups": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "review.schema.json#/$defs/verdict"
      }
    },
    "stitches": {
      "type": "array",
      "items": {
        "$ref": "stitch.schema.json"
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "created_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "withdrawn_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      }
    },
    "condition_edit_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "condition_id": {
            "type": "string",
            "minLength": 1
          },
          "proposed": {
            "type": "object"
          },
          "rationale": {
            "type": "string"
          },
          "proposed_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        },
        "required": [
          "id",
          "condition_id",
          "proposed"
        ],
        "additionalProperties": true
      }
    },
    "rfis": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "cable_runs": {
      "type": "array",
      "description": "Division 27 cable runs (docs/design/CABLE_SETUP.md): one device location \u2192 its route segments in order \u2192 a TR marker, all by shape id. Stores no length; lengths resolve from the referenced shapes. A record carrying `hold` is a HOLD instead: device locations deliberately left without a run, with the reason (empty route_shape_ids and tr_id). Omitted when empty.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "device_shape_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "route_shape_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tr_id": {
            "type": "string"
          },
          "cables_override": {
            "type": "integer",
            "minimum": 1
          },
          "vertical_override": {
            "type": "number",
            "minimum": 0,
            "description": "The run's own vertical in feet, replacing the device condition's cable_setup.vertical_ft for this location only (a stated allowance, never estimated). Omitted = the condition's."
          },
          "hold": {
            "type": "object",
            "description": "Present on a hold record: the devices get no run by decision. Excluded from totals like an unlinked device, listed with the reason.",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": true
          },
          "provenance": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string"
              },
              "actor": {
                "type": "string"
              },
              "reviewed": {
                "type": "boolean"
              },
              "created_at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
              "author": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "device_shape_ids",
          "route_shape_ids",
          "tr_id"
        ],
        "additionalProperties": true
      }
    },
    "sheet_group": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_group": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sheet_tabs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sheet_levels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "layer_overrides": {
      "type": "object"
    },
    "condition_columns": {
      "type": "array"
    },
    "shape_labels": {
      "type": "array"
    },
    "palette": {
      "type": "array"
    },
    "provenance_counters": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Known collections shared by the draft and legacy structural profile. Some secondary families are opaque objects pending the full compatibility corpus. Unknown extensions are permitted and must be preserved by future adapters."
}
